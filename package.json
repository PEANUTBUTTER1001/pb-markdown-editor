{
  "name": "pb-markdown-editor",
  "productName": "PB Markdown Editor",
  "version": "1.1.0",
  "description": "A simple Markdown viewer and editor.",
  "main": "index.js",
  "scripts": {
    "prebuild-icon": "node make-icon.js",
    "build:js": "esbuild popup.js --bundle --minify --outfile=assets/bundle.min.js --platform=browser --main-fields=module,main",
    "test": "node --test tests/*.test.js",
    "prestart": "npm run prebuild-icon && npm run build:js",
    "start": "electron .",
    "build:portable": "npm run prebuild-icon && npm run build:js && electron-builder --win portable && npx rimraf dist/win-unpacked dist/*.yaml dist/*.yml dist/.icon-ico",
    "build:installer": "npm run prebuild-icon && npm run build:js && electron-builder --win nsis && npx rimraf dist/win-unpacked dist/*.yaml dist/*.yml dist/*.blockmap dist/.icon-ico"
  },
  "author": "PEANUTBUTTER1001",
  "license": "ISC",
  "devDependencies": {
    "electron": "^43.2.0",
    "electron-builder": "^26.15.3",
    "esbuild": "^0.28.1",
    "jimp": "^0.22.10",
    "png-to-ico": "^3.0.2"
  },
  "build": {
    "appId": "io.github.peanutbutter1001.pbmarkdowneditor",
    "files": [
      "index.js",
      "preload.js",
      "src/main/**/*",
      "popup.html",
      "popup.css",
      "lib/**/*",
      "assets/bundle.min.js",
      "assets/icon.ico",
      "assets/buttonicons/**/*"
    ],
    "win": {
      "target": [
        "portable",
        "nsis"
      ],
      "icon": "assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "fileAssociations": [
      {
        "ext": "json",
        "name": "JSON Document",
        "description": "JSON Document",
        "icon": "assets/icon.ico"
      },
      {
        "ext": "md",
        "name": "Markdown Document",
        "description": "Markdown Document",
        "icon": "assets/icon.ico"
      }
    ]
  },
  "dependencies": {
    "@codemirror/commands": "6.11.1",
    "@codemirror/lang-json": "6.0.2",
    "@codemirror/language": "6.12.4",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.13",
    "@lezer/highlight": "1.2.5",
    "jsonc-parser": "3.3.1"
  }
}
